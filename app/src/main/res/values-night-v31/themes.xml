<resources>

    <!-- Material You dynamic color, dark mode - see values-v31/themes.xml for the light mode version. -->
    <style name="System">
        <item name="colorPrimary">@android:color/system_accent1_700</item>
        <item name="colorPrimaryDark">@android:color/system_accent1_800</item>
        <item name="colorAccent">@android:color/system_accent1_200</item>
        <item name="colorCardBackground">@android:color/system_neutral1_900</item>
        <item name="colorCardHighlight">@android:color/system_neutral1_800</item>
        <item name="android:textColorPrimary">@android:color/system_neutral1_50</item>
        <item name="android:textColorSecondary">@android:color/system_neutral1_400</item>
        <item name="alertDialogTheme">@style/AppAlertDialog.Dark.System</item>
        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialog.Dark.System</item>
    </style>

    <style name="AppAlertDialog.Dark.System">
        <item name="colorPrimary">@android:color/system_accent1_700</item>
        <item name="colorAccent">@android:color/system_accent1_200</item>
        <item name="android:textColorPrimary">@android:color/system_neutral1_50</item>
        <item name="android:textColorSecondary">@android:color/system_neutral1_400</item>
        <item name="colorCardBackground">@android:color/system_neutral1_900</item>
        <item name="colorCardHighlight">@android:color/system_neutral1_800</item>
    </style>

    <style name="AppBottomSheetDialog.Dark.System">
        <item name="colorPrimary">@android:color/system_accent1_700</item>
        <item name="colorAccent">@android:color/system_accent1_200</item>
        <item name="android:textColorPrimary">@android:color/system_neutral1_50</item>
        <item name="android:textColorSecondary">@android:color/system_neutral1_400</item>
        <item name="android:colorBackground">@android:color/system_neutral1_900</item>
    </style>

</resources>
