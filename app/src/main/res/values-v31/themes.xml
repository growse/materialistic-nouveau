<resources>

    <!--
      Material You dynamic color, light mode: tints the app with the wallpaper-derived palette
      the OS exposes as @android:color/system_accent1_*/system_neutral1_* on API 31+. Only ever
      selected by ThemePreference when DynamicColors.isDynamicColorAvailable() is true.
    -->
    <style name="System">
        <item name="colorPrimary">@android:color/system_accent1_300</item>
        <item name="colorPrimaryDark">@android:color/system_accent1_400</item>
        <item name="colorAccent">@android:color/system_accent1_600</item>
        <item name="colorCardBackground">@android:color/system_accent1_50</item>
        <item name="colorCardHighlight">@android:color/system_accent1_100</item>
        <item name="android:textColorPrimary">@android:color/system_neutral1_900</item>
        <item name="android:textColorSecondary">@android:color/system_neutral1_600</item>
        <item name="alertDialogTheme">@style/AppAlertDialog.System</item>
        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialog.System</item>
    </style>

    <style name="AppAlertDialog.System">
        <item name="colorPrimary">@android:color/system_accent1_300</item>
        <item name="colorAccent">@android:color/system_accent1_600</item>
        <item name="android:textColorPrimary">@android:color/system_neutral1_900</item>
        <item name="android:textColorSecondary">@android:color/system_neutral1_600</item>
        <item name="colorCardBackground">@android:color/system_accent1_50</item>
        <item name="colorCardHighlight">@android:color/system_accent1_100</item>
    </style>

    <style name="AppBottomSheetDialog.System">
        <item name="colorPrimary">@android:color/system_accent1_300</item>
        <item name="colorAccent">@android:color/system_accent1_600</item>
        <item name="android:textColorPrimary">@android:color/system_neutral1_900</item>
        <item name="android:textColorSecondary">@android:color/system_neutral1_600</item>
        <item name="android:colorBackground">@android:color/system_accent1_50</item>
    </style>

</resources>
